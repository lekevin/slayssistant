node_modules/
.next/
.env.local
*.tsbuildinfo
next-env.d.ts
.DS_Store

# The source PDF is not ours to redistribute. data/parsed/rulebook.md is the
# committed artifact; regenerate it with `npm run parse` from your own copy.
data/source/

# Rebuild accelerators, not artifacts. embeddings.bin is the shipped index;
# these just make re-chunking and re-running the eval cheap locally.
data/index/.embed-cache.json
data/index/.query-cache.json

# Per-question answer checkpoint. Keyed by model + index + prompt + retrieval
# options, so it self-invalidates when the answering path changes. Lets a
# crashed eval:answers run resume instead of re-buying every answer.
eval/.answers-cache.jsonl

# Regenerated by /graphify; graph.html/graph.json/GRAPH_REPORT.md are derived
# from the corpus, not source of truth.
graphify-out/
